{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

<div class="modal-dialog" role="document">
    <div class="mt-3 mb-2 {% if not form.vars.valid %}was-validated{% endif %}">
        {% include 'core/default_templates/form_main_error.html.twig' %}
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'api-form'}}) }}
        {{ form_row(form._token) }}
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchFormLabel">{{'supplier.add.form'|dtrans}}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="api-error alert alert-danger"></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                    {{ form_table.tr(form.name) }}
                    {{ form_table.tr(form.countryCode) }}
                    {{ form_table.tr(form.eek) }}
                    <div class="mb-3"><button type="button" id="getCompanyData" class="btn btn-sm btn-secondary" data-url="{{ path('supplier_api_supplier_get_company_data') }}">Вземи данни</button></div>
                    {{ form_table.tr(form.vat) }}
                    {{ form_table.tr(form.responsiblePerson) }}
                    {{ form_table.tr(form.address) }}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                {{ form_widget(form.save, {"attr": {"class": "btn btn-success api-save", "data-url": path('supplier_api_save_add_supplier', app.request.attributes.get('_route_params', {})|merge(app.request.query.all)) }}) }}
            </div>
        </div>
        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div> 